{
  "name": "vue-grab",
  "version": "0.1.0",
  "description": "Select Vue UI elements and copy agent-ready source context",
  "keywords": [
    "vue",
    "agent",
    "context",
    "grab",
    "devtools"
  ],
  "license": "MIT",
  "author": "Vue Grab contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vue-grab/vue-grab.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "import": "./dist/compiler.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@vue/compiler-dom": "3.5.44",
    "@vue/compiler-sfc": "^3.5.44",
    "magic-string": "^1.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "^21.0.3",
    "jsdom": "30.1.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue": "3.5.44"
  }
}
