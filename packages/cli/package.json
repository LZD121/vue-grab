{
  "name": "@vue-grab-dev/cli",
  "version": "0.1.1",
  "description": "Install and configure Vue Grab in a Vue project",
  "keywords": [
    "vue",
    "vue-grab",
    "cli",
    "devtools",
    "vite",
    "nuxt"
  ],
  "license": "MIT",
  "author": "Vue Grab contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vue-grab/vue-grab.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/vue-grab/vue-grab#readme",
  "bugs": "https://github.com/vue-grab/vue-grab/issues",
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "vue-grab": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": "./dist/cli.js"
  },
  "scripts": {
    "build": "vite build",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "commander": "14.0.3",
    "package-manager-detector": "1.9.0",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
