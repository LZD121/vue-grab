{
  "name": "vue-grab-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @vue-grab/demo dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "pnpm build && pnpm --filter vue-grab publish --access public && pnpm --filter @vue-grab-dev/cli publish --access public"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.10.0",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/compiler-sfc": "3.5.44",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "vue": "3.5.44"
  }
}
